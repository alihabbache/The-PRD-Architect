# LLM Provider: "groq" or "ollama"
LLM_PROVIDER=groq

# Groq API key (get one free at https://console.groq.com)
# Required when LLM_PROVIDER=groq — the server will refuse to start without it.
GROQ_API_KEY=your_groq_api_key_here

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Security (optional overrides) ──────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Default: http://localhost:5173 (Vite dev server)
# ALLOWED_ORIGINS=https://your-frontend.example.com

# Set to "production" to disable /docs and /redoc routes.
# APP_ENV=production
